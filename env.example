# Cadastre estas variáveis em: Netlify > Site configuration > Environment variables
# (escopo: marque "Functions"). Para testar local, copie para .env.
ATENAS_API_KEY=atenaspay_live_xxxxxxxx
ATENAS_WEBHOOK_SECRET=nxps_xxxxxxxx
