# Cadastre estas variáveis em: Netlify > Site configuration > Environment variables
# (escopo: marque "Functions"). Para testar local, copie para .env.
ATENAS_API_KEY=atenaspay_live_xxxxxxxx
ATENAS_WEBHOOK_SECRET=nxps_xxxxxxxx
# Gere duas strings DIFERENTES com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LICENSE_PEPPER=troque-por-uma-string-aleatoria-de-96-caracteres
ADMIN_TOKEN=troque-por-outra-string-aleatoria-de-96-caracteres
# opcionais
# MAX_DEVICES=2
# ATENAS_BASE_URL=https://atenaspay.com.br
# --- proteções opcionais (veja GUIA-PIX.md) ---
# TURNSTILE_SECRET=segredo-do-cloudflare-turnstile
# CHECKOUT_PAUSED=1
# AMOUNT_UNIT=reais
# --- segurança (veja SEGURANCA.md) ---
# Chave que cifra nome, e-mail, WhatsApp e chaves guardados (mín. 32 caracteres, DIFERENTE das outras). Não troque depois de usar.
DATA_KEY=troque-por-mais-uma-string-aleatoria-de-96-caracteres
# Opcional: só estes IPs acessam o /admin (separe por vírgula)
# ADMIN_IPS=200.100.50.25
